replicas: 1

serviceAccount:
  create: true
  name: {{ grafana_service_account_name }}

service:
  enabled: true
  type: {{ grafana_service_type }}
  port: {{ grafana_remote_port }}

admin:
  existingSecret: {{ grafana_admin_secret_name }}
  userKey: admin-user
  passwordKey: admin-password

persistence:
  enabled: false

resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: 500m
    memory: 512Mi
